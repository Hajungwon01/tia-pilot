# 이 파일을 복사해 `.env`를 만들고 채우세요. `.env`는 git에 올라가지 않습니다(.gitignore).

# ── LLM ──
# 선택한 제공자의 키가 비어 있으면 LLM은 mock 모드로 동작합니다.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 비워 두면 제공자별 기본 모델(openai: gpt-4o-mini, anthropic: claude-sonnet-5-5)
LLM_MODEL=
MAX_REFLECTION_RETRIES=1

# ── 웹 서비스 ──
# dev(기본): 인증 없이 열림. production: BETA_CODES와 SECRET_KEY가 없으면 앱이 시작되지 않음(공개 배포 시 필수)
APP_ENV=dev
# 쉼표로 구분한 베타 초대 코드(사용자마다 하나씩 나눠 주세요). 코드를 바꾸면 그 사용자의 로그인이 끊깁니다.
BETA_CODES=
# 세션 쿠키 서명 키: 32자 이상 무작위 문자열. 예) python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_TTL_HOURS=12
# 프록시(Railway 등) 뒤에서 실행하면 true — 로그인 시도 제한이 실제 클라이언트 IP로 동작
TRUST_PROXY=false

# 실제 LLM 사용 시에만 요구하는 추가 코드(과금 보호). production에서 LLM 키를 쓰면 필수
APP_ACCESS_CODE=
MAX_LIVE_RUNS_PER_HOUR=10

# 결과 저장(SQLite). 배포 시 영구 볼륨 경로로 지정(예: /data/app.db). 컨테이너 임시 디스크면 재배포 때 사라집니다.
DB_PATH=data/app.db
JOB_TTL_HOURS=72
